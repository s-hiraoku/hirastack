  "requirements": [
    {
      "id": "SELF-001",
      "title": "プロジェクト独立",
      "statement": "汎用runner/skillsと対象固有の契約・helperを分離し、異なるoriginと言語の対象を同じCLIで扱う。",
      "rationale": "ある対象プロジェクトの要件や文書を汎用部・他projectへ持ち込まない。",
      "scope": "Python CLIの32件の回帰と独立一時Git repoの実CLI経路。全projectの設計抽出正当性や悪意あるcode隔離は対象外。",
      "decision": "accepted",
